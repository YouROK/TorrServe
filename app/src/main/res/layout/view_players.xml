<?xml version="1.0" encoding="utf-8"?>
<!-- Выбор плеера внутри окна (без отдельного окна-диалога) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_choose"
        android:textColor="@color/silo_steel_bright"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/players_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="320dp" />

    <CheckBox
        android:id="@+id/players_remember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/player_remember"
        android:textColor="@color/silo_text"
        android:buttonTint="@color/silo_amber" />

</LinearLayout>
