<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Шапка торрента: постер + сведения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ru.yourok.torrserve.ui.PosterImageView
            android:id="@+id/detail_poster"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_poster_placeholder"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
                android:textColor="@color/silo_steel_bright"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/silo_text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/detail_hash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/silo_text_faint"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detail_play"
                    style="@style/SiloButton"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/card_selector"
                    android:text="@string/detail_play_first"
                    android:textColor="@color/silo_amber_bright" />

                <TextView
                    android:id="@+id/detail_delete"
                    style="@style/SiloButton"
                    android:background="@drawable/card_selector"
                    android:text="@string/torrent_delete"
                    android:textColor="@color/silo_danger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Вкладки типов файлов (заполняются кодом) -->
    <LinearLayout
        android:id="@+id/detail_tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/detail_no_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/detail_no_files"
        android:textColor="@color/silo_text_faint"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detail_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
