<?xml version="1.0" encoding="utf-8"?>
<!-- Панель предзагрузки: одна и та же в окне раздачи и в главном окне -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/prep_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/silo_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/prep_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/prep_getting_info"
        android:textColor="@color/silo_text_muted"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/prep_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:max="100" />

    <TextView
        android:id="@+id/prep_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textColor="@color/silo_amber"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prep_cancel"
            style="@style/SiloButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/prep_cancel"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/prep_open"
            style="@style/SiloButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/prep_open_now"
            android:textColor="@color/silo_amber"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
