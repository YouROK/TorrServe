<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/owner_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/owner_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/owner_hint"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/owner_password_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/owner_hint_confirm"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/owner_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B00020"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/owner_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/owner_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/owner_submit" />

</LinearLayout>
