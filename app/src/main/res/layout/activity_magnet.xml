<?xml version="1.0" encoding="utf-8"?>
<!-- Окно раздачи из другого приложения: одно окно, страницы меняются внутри.
     действие → ожидание → файлы → предзагрузка → выбор плеера -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/magnet_window"
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/magnet_title"
                android:textColor="@color/silo_steel_bright"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/magnet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/silo_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- ============ Страница 1: действие ============ -->
            <LinearLayout
                android:id="@+id/magnet_page_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/magnet_user_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/magnet_as_user"
                    android:textColor="@color/silo_text_faint"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/magnet_users"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/magnet_action_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/magnet_action"
                    android:textColor="@color/silo_text_faint"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/magnet_actions_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <CheckBox
                    android:id="@+id/magnet_remember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/magnet_remember"
                    android:textColor="@color/silo_text_muted"
                    android:buttonTint="@color/silo_amber" />

                <TextView
                    android:id="@+id/magnet_run"
                    style="@style/SiloButtonPrimary"
                    android:layout_marginTop="14dp"
                    android:text="@string/magnet_run" />
            </LinearLayout>

            <!-- ============ Страница 2: ожидание (добавление, метаданные) ============ -->
            <LinearLayout
                android:id="@+id/magnet_page_busy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/magnet_busy_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:indeterminate="true"
                    android:max="100" />

                <TextView
                    android:id="@+id/magnet_busy_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/magnet_adding"
                    android:textColor="@color/silo_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ============ Страница 3: файлы ============ -->
            <LinearLayout
                android:id="@+id/magnet_page_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/magnet_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <!-- Высоту списка задаёт MagnetActivity: карточка должна влезать в экран,
                     а прокручиваться должен только список файлов, не всё окно. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/magnet_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/magnet_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/silo_text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ============ Страница 4: предзагрузка (панель добавляется кодом) ============ -->
            <FrameLayout
                android:id="@+id/magnet_preload_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <!-- ============ Страница 5: выбор плеера ============ -->
            <LinearLayout
                android:id="@+id/magnet_page_players"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/view_players" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
