<?xml version="1.0" encoding="utf-8"?>
<!-- Окно добавления раздачи: две страницы - выбор действия и выбор файла -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/magnet_title"
                android:textColor="@color/silo_steel_bright"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/magnet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/silo_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- ============ Страница 1: действие ============ -->
            <LinearLayout
                android:id="@+id/magnet_page_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/magnet_user_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/magnet_as_user"
                    android:textColor="@color/silo_text_faint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/magnet_users"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/magnet_action_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/magnet_action"
                    android:textColor="@color/silo_text_faint"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/magnet_actions_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <CheckBox
                    android:id="@+id/magnet_remember"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/magnet_remember"
                    android:textColor="@color/silo_text_muted"
                    android:buttonTint="@color/silo_amber" />

                <TextView
                    android:id="@+id/magnet_run"
                    style="@style/SiloButtonPrimary"
                    android:layout_marginTop="14dp"
                    android:text="@string/magnet_run" />
            </LinearLayout>

            <!-- ============ Страница 2: файлы ============ -->
            <LinearLayout
                android:id="@+id/magnet_page_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/magnet_tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/magnet_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxHeight="300dp" />

                <TextView
                    android:id="@+id/magnet_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/silo_text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
