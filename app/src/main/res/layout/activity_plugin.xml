<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/silo_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/silo_bg_raised"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/plugin_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/nav_item_selector"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/plugin_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:textColor="@color/silo_steel_bright"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <WebView
        android:id="@+id/plugin_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/silo_bg" />

</LinearLayout>
