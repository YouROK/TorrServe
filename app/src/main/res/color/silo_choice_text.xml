<?xml version="1.0" encoding="utf-8"?>
<!-- Текст кнопки выбора: янтарный у выбранной и у кнопки в фокусе -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/silo_amber_bright" />
    <item android:state_selected="true" android:color="@color/silo_amber" />
    <item android:state_enabled="false" android:color="@color/silo_text_faint" />
    <item android:color="@color/silo_text" />
</selector>
